---
// Monthly cross-show podcast digest, IBM Carbon style. Data: src/data/podcast-digests/
// (scripts/podcast-digest.mjs). Only months with themes are built.
import WideLayout from "../../../layouts/WideLayout.astro";
import { getDigests, internalLinks, internalHref, monthLabel, SHOW_ORDER, SHOW_SHORT, type Digest } from "../../../lib/podcast-digests";
import { getDailies } from "../../../lib/podcast-daily";

export async function getStaticPaths() {
    const all = getDigests();
    return all.map((d, i) => ({
        params: { period: d.period },
        props: { d, newer: all[i - 1]?.period ?? null, older: all[i + 1]?.period ?? null },
    }));
}

const { d, newer, older } = Astro.props as { d: Digest; newer: string | null; older: string | null };
const base = import.meta.env.BASE_URL;
const links = await internalLinks();
const byKey = new Map(d.episodes.map((e) => [e.key, e]));
const shows = [...SHOW_ORDER.filter((s) => d.counts[s]), ...Object.keys(d.counts).filter((s) => !SHOW_ORDER.includes(s)).sort()];
const showName = (s: string) => d.episodes.find((e) => e.show === s)?.showName ?? s;
const short = (s: string) => SHOW_SHORT[s] ?? s;
const eid = (k: string) => "ep-" + k.replace(/[^a-zA-Z0-9]/g, "-");
const nice = (iso: string) => { const t = new Date(iso + "T00:00:00Z"); return t.toLocaleDateString("en-us", { month: "short", day: "numeric", timeZone: "UTC" }); };
const dayParts = (iso: string) => { const t = new Date(iso + "T00:00:00Z"); return { day: t.getUTCDate(), rest: t.toLocaleDateString("en-us", { month: "short", weekday: "short", timeZone: "UTC" }) }; };
const label = monthLabel(d.period);
const lastEp = d.episodes.reduce((m, e) => (e.date > m ? e.date : m), d.start);
const notesCount = d.episodes.filter((e) => e.summarySource === "show-notes").length;
const dailies = getDailies().filter((x) => x.month === d.period).reverse();
---

<WideLayout title={`Podcast digest: ${label}`} description={d.headline ?? `What the AI podcasts covered in ${label}`}>
<div class="ibm">
    <header class="masthead">
        <a class="brand" href={`${base}podcasts/digest/`}>Podcast Digest <span>· {label}</span></a>
        <nav>
            <a href="#themes">Themes</a>
            {shows.map((s) => <a href={`#show-${s}`}>{short(s)}</a>)}
            {d.implications.length > 0 && <a href="#implications">Implications</a>}
            {dailies.length > 0 && <a href="#daily">Daily</a>}
        </nav>
    </header>

    <div class="wrap hero">
        <div class="crumbs mono">
            <a href={`${base}podcasts/`}>Podcasts</a> / <a href={`${base}podcasts/digest/`}>Digest</a> / {d.period}
        </div>
        <div class="eyebrow mono">
            {nice(d.start)} – {d.inProgress ? nice(lastEp) : nice(d.end)} {d.period.slice(0, 4)} · {d.episodeCount} episodes · {shows.length} shows
            {d.inProgress && <span class="tag warn">In progress</span>}
        </div>
        <h1>What the AI podcasts said in {label}</h1>
        {d.headline && <p class="lede">{d.headline}</p>}
        <div class="stats">
            <div class="stat total"><div class="n">{d.episodeCount}</div><div class="l">episodes</div></div>
            {shows.map((s) => (
                <a class="stat" href={`#show-${s}`}><div class="n">{d.counts[s]}</div><div class="l">{showName(s)}</div></a>
            ))}
        </div>
        <div class="pager">
            {older ? <a href={`${base}podcasts/digest/${older}/`}>← {monthLabel(older)}</a> : <span></span>}
            {newer ? <a href={`${base}podcasts/digest/${newer}/`}>{monthLabel(newer)} →</a> : <span></span>}
        </div>
    </div>

    <section class="alt" id="themes">
        <div class="wrap">
            <h2>Cross-show themes</h2>
            <p class="sub">Synthesised from the episode summaries. Claims are as reported on the shows, not verified. Chips jump to the episode.</p>
            <div class="themes">
                {d.themes.map((t, i) => (
                    <article class="tile">
                        <div class="num mono">THEME {String(i + 1).padStart(2, "0")}</div>
                        <h3>{t.title}</h3>
                        <p>{t.body}</p>
                        <div class="chips">
                            {t.eps.map((k) => byKey.get(k)).filter(Boolean).sort((a, b) => a!.date.localeCompare(b!.date)).map((e) => (
                                <a class="tag" href={`#${eid(e!.key)}`} title={e!.title}>{short(e!.show)} · {nice(e!.date)}</a>
                            ))}
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section id="episodes">
        <div class="wrap">
            <h2>All episodes</h2>
            <p class="sub">Newest first, grouped by show. Titles link to the original episode; "Summary" links to the longer summary on this site.</p>
            <div class="filter" role="tablist">
                <button class="on" data-f="all">All shows</button>
                {shows.map((s) => <button data-f={`show-${s}`}>{short(s)}</button>)}
            </div>
            {shows.map((s) => {
                const items = d.episodes.filter((e) => e.show === s);
                return (
                    <div class="show" id={`show-${s}`}>
                        <div class="show-h"><h3>{showName(s)}</h3><span class="c">{items.length} episode{items.length === 1 ? "" : "s"}</span></div>
                        {items.map((e) => {
                            const dp = dayParts(e.date);
                            const own = internalHref(links, e);
                            return (
                                <article class="ep" id={eid(e.key)}>
                                    <div class="d mono"><b>{dp.day}</b>{dp.rest}</div>
                                    <div>
                                        <h4>{e.url ? <a href={e.url} target="_blank" rel="noopener">{e.title}</a> : e.title}</h4>
                                        <div class="meta">
                                            {[e.guests.length ? `Guests: ${e.guests.join(", ")}` : "", e.durationMin ? `${e.durationMin} min` : ""].filter(Boolean).join(" · ")}
                                        </div>
                                        <p>{e.summary ?? "No summary yet."}{e.summarySource === "show-notes" && <span class="src"> (from the show notes)</span>}</p>
                                        <div class="links">
                                            {e.url && <a href={e.url} target="_blank" rel="noopener">Episode</a>}
                                            {own && <a href={`${base}${own}`}>Summary</a>}
                                            {e.youtube && <a href={e.youtube} target="_blank" rel="noopener">YouTube</a>}
                                        </div>
                                    </div>
                                </article>
                            );
                        })}
                    </div>
                );
            })}
        </div>
    </section>

    {d.implications.length > 0 && (
        <section class="dark" id="implications">
            <div class="wrap">
                <h2>What it means for enterprise architecture</h2>
                <p class="sub">My reading of the month for architects and technology leaders, not a finding of the shows.</p>
                <ol>{d.implications.map((v) => <li>{v}</li>)}</ol>
            </div>
        </section>
    )}

    {dailies.length > 0 && (
        <section class="alt" id="daily">
            <div class="wrap">
                <h2>Day by day</h2>
                <p class="sub">The <a href={`${base}podcasts/daily/`}>daily summaries</a> for {label}: what mattered each day across the shows.</p>
                <div class="days">
                    {dailies.map((x) => (
                        <a class="day" href={`${base}podcasts/daily/${x.date}/`} title={x.headline ?? ""}>
                            <b>{Number(x.date.slice(8, 10))}</b>
                            <span class="mono">{x.weekday.slice(0, 3)} · {x.episodeCount} ep</span>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <footer class="wrap foot">
        Generated {d.generated} from episode summaries of {shows.length} shows
        {notesCount > 0 && <> ({notesCount} episode{notesCount === 1 ? "" : "s"} summarised from the publisher's show notes)</>}.
        Latent Space transcripts have no speaker labels, so attributions there are softer.
    </footer>
</div>
</WideLayout>

<script>
    const btns = document.querySelectorAll<HTMLButtonElement>(".ibm .filter button");
    btns.forEach((b) => b.addEventListener("click", () => {
        btns.forEach((x) => x.classList.toggle("on", x === b));
        document.querySelectorAll<HTMLElement>(".ibm .show").forEach((s) => {
            s.style.display = b.dataset.f === "all" || s.id === b.dataset.f ? "" : "none";
        });
    }));
    document.querySelectorAll('.ibm a[href^="#ep-"]').forEach((a) => a.addEventListener("click", () => btns[0]?.click()));
</script>

<style>
    .ibm {
        --cds-layer-01: #f4f4f4; --cds-layer-02: #e0e0e0; --cds-layer-hover: #e8e8e8;
        --cds-text-primary: #161616; --cds-text-secondary: #525252; --cds-text-helper: #6f6f6f;
        --cds-border-subtle: #c6c6c6; --cds-link: #0f62fe; --cds-link-hover: #0043ce; --cds-blue-10: #edf5ff;
        font-family: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        color: var(--cds-text-primary); background: #fff; font-size: 16px; line-height: 1.5; letter-spacing: 0;
    }
    .ibm :is(h1, h2, h3, h4) { font-family: 'IBM Plex Sans', system-ui, sans-serif; letter-spacing: 0; color: var(--cds-text-primary); margin: 0; }
    .ibm a { color: var(--cds-link); text-decoration: none; }
    .ibm a:hover { color: var(--cds-link-hover); text-decoration: underline; }
    .ibm .mono { font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; }
    .masthead { position: sticky; top: 0; z-index: 10; height: 48px; background: #161616; display: flex; align-items: center; padding: 0 16px; gap: 32px; }
    .ibm .masthead .brand { color: #fff; font-size: 14px; font-weight: 600; letter-spacing: .16px; white-space: nowrap; }
    .masthead .brand span { font-weight: 400; color: #c6c6c6; }
    .masthead nav { display: flex; height: 48px; overflow-x: auto; scrollbar-width: none; }
    .ibm .masthead nav a { color: #c6c6c6; font-size: 14px; letter-spacing: .16px; padding: 0 16px; display: flex; align-items: center; white-space: nowrap; }
    .ibm .masthead nav a:hover { color: #fff; background: #262626; text-decoration: none; }
    .wrap { max-width: 1584px; margin: 0 auto; padding: 0 32px; }
    .hero { padding-top: 48px; padding-bottom: 48px; border-bottom: 1px solid var(--cds-layer-02); }
    .crumbs { font-size: 12px; letter-spacing: .32px; color: var(--cds-text-helper); margin-bottom: 24px; }
    .eyebrow { font-size: 12px; letter-spacing: .32px; color: var(--cds-text-secondary); text-transform: uppercase; margin-bottom: 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .ibm h1 { font-size: 60px; line-height: 1.17; font-weight: 300; max-width: 1100px; }
    .lede { font-size: 20px; line-height: 1.4; font-weight: 300; color: var(--cds-text-secondary); max-width: 960px; margin: 24px 0 0; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: var(--cds-layer-02); margin-top: 48px; border: 1px solid var(--cds-layer-02); }
    .ibm .stat { background: var(--cds-layer-01); padding: 16px; display: block; color: inherit; }
    .ibm a.stat:hover { background: var(--cds-layer-hover); text-decoration: none; }
    .stat .n { font-size: 42px; font-weight: 300; line-height: 1.19; }
    .stat .l { font-size: 14px; letter-spacing: .16px; color: var(--cds-text-secondary); }
    .ibm .stat.total { background: #161616; color: #fff; }
    .stat.total .l { color: #c6c6c6; }
    .pager { display: flex; justify-content: space-between; margin-top: 24px; font-size: 14px; letter-spacing: .16px; }
    .ibm section { padding: 48px 0; }
    .ibm section.alt { background: var(--cds-layer-01); }
    .ibm h2 { font-size: 32px; line-height: 1.25; font-weight: 400; margin-bottom: 8px; }
    .sub { font-size: 14px; letter-spacing: .16px; color: var(--cds-text-secondary); margin: 0 0 32px; }
    .themes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .tile { background: #fff; padding: 24px; display: flex; flex-direction: column; gap: 12px; border-top: 2px solid var(--cds-link); }
    .tile .num { font-size: 12px; letter-spacing: .32px; color: var(--cds-text-helper); }
    .ibm .tile h3 { font-size: 20px; line-height: 1.4; font-weight: 600; }
    .tile p { font-size: 14px; line-height: 1.43; letter-spacing: .16px; color: var(--cds-text-secondary); margin: 0; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
    .ibm .tag { display: inline-block; background: var(--cds-blue-10); color: var(--cds-link); font-size: 12px; padding: 4px 8px; border-radius: 24px; line-height: 16px; white-space: nowrap; letter-spacing: 0; text-transform: none; }
    .ibm a.tag:hover { background: #d0e2ff; text-decoration: none; }
    .ibm .tag.warn { background: #fcf4d6; color: #8e6a00; }
    .filter { display: flex; flex-wrap: wrap; margin-bottom: 32px; border-bottom: 1px solid var(--cds-border-subtle); }
    .filter button { font: inherit; font-size: 14px; letter-spacing: .16px; background: transparent; border: 0; border-bottom: 2px solid transparent; padding: 12px 16px; color: var(--cds-text-secondary); cursor: pointer; height: 48px; border-radius: 0; }
    .filter button:hover { background: var(--cds-layer-hover); color: var(--cds-text-primary); }
    .filter button.on { border-bottom-color: var(--cds-link); color: var(--cds-text-primary); font-weight: 600; }
    .show { margin-bottom: 48px; }
    .show-h { display: flex; align-items: baseline; gap: 16px; border-bottom: 2px solid var(--cds-text-primary); padding-bottom: 8px; }
    .ibm .show-h h3 { font-size: 24px; line-height: 1.33; font-weight: 400; }
    .show-h .c { font-size: 14px; color: var(--cds-text-secondary); letter-spacing: .16px; }
    .ep { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--cds-layer-02); scroll-margin-top: 56px; }
    .ep:target { background: var(--cds-blue-10); outline: 2px solid var(--cds-link); outline-offset: -2px; }
    .ep .d { font-size: 14px; letter-spacing: .16px; color: var(--cds-text-secondary); padding-left: 8px; }
    .ep .d b { display: block; font-weight: 400; font-size: 24px; line-height: 1.2; color: var(--cds-text-primary); }
    .ibm .ep h4 { font-size: 16px; font-weight: 600; line-height: 1.5; }
    .ep .meta { font-size: 12px; letter-spacing: .32px; color: var(--cds-text-helper); margin: 4px 0 8px; min-height: 4px; }
    .ep p { font-size: 14px; line-height: 1.43; letter-spacing: .16px; color: var(--cds-text-secondary); max-width: 960px; margin: 0; }
    .ep .src { color: var(--cds-text-helper); font-style: italic; }
    .links { display: flex; gap: 16px; margin-top: 12px; font-size: 14px; letter-spacing: .16px; }
    .links a::after { content: " \2192"; }
    .ibm section.dark { background: #161616; color: #f4f4f4; }
    .ibm .dark h2 { color: #fff; }
    .dark .sub { color: #c6c6c6; }
    .dark ol { list-style: none; counter-reset: v; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin: 0; padding: 0; }
    .dark li { counter-increment: v; background: #262626; padding: 24px; font-size: 14px; line-height: 1.43; letter-spacing: .16px; color: #c6c6c6; }
    .dark li::before { content: counter(v, decimal-leading-zero); display: block; font-family: 'IBM Plex Mono', monospace; color: #78a9ff; font-size: 14px; margin-bottom: 8px; }
    .foot { padding-top: 32px; padding-bottom: 48px; font-size: 12px; letter-spacing: .32px; color: var(--cds-text-helper); }
    .days { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 1px; background: var(--cds-layer-02); border: 1px solid var(--cds-layer-02); }
    .ibm .day { background: #fff; padding: 12px 16px; display: flex; flex-direction: column; color: var(--cds-text-primary); }
    .ibm .day:hover { background: var(--cds-layer-hover); text-decoration: none; }
    .day b { font-size: 28px; font-weight: 300; line-height: 1.2; color: var(--cds-link); }
    .day span { font-size: 12px; letter-spacing: .32px; color: var(--cds-text-secondary); }
    @media (max-width: 1056px) { .ibm h1 { font-size: 42px; line-height: 1.19; } }
    @media (max-width: 672px) {
        .wrap { padding: 0 16px; }
        .themes { grid-template-columns: minmax(0, 1fr); }
        .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .ibm h1 { font-size: 32px; line-height: 1.25; }
        .hero { padding-top: 32px; padding-bottom: 32px; }
        .ep { grid-template-columns: minmax(0, 1fr); gap: 8px; }
        .ep .d { padding-left: 0; }
        .ep .d b { display: inline; font-size: 16px; margin-right: 8px; }
        .masthead { gap: 8px; }
        .masthead .brand span { display: none; }
    }
</style>
