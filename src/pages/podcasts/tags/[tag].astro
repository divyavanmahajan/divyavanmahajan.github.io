---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getPodcastShow } from "../../../podcast-shows.mjs";

// Topic tags across podcast summaries only (kept apart from blog /tags/ and
// TIL /til/tags/ so podcast topics don't flood the blog's taxonomy).
export async function getStaticPaths() {
    const episodes = (await getCollection("podcasts")).filter((e) => !e.data.draft);
    const tags = [...new Set(episodes.flatMap((e) => e.data.tags))];
    return tags.map((tag) => ({
        params: { tag },
        props: {
            episodes: episodes
                .filter((e) => e.data.tags.includes(tag))
                .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
        },
    }));
}

const { tag } = Astro.params;
const { episodes } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Podcasts tagged "${tag}"`} description={`Podcast episode summaries tagged ${tag}`} withSidebar={false}>
    <div class="tag-page">
        <nav class="breadcrumb"><a href={`${base}podcasts/`}>Podcasts</a> <span>›</span> <span>Tag</span></nav>
        <h1>#{tag}</h1>
        <ul>
            {episodes.map((ep) => (
                <li>
                    <time datetime={ep.data.pubDate.toISOString()}>
                        {ep.data.pubDate.toLocaleDateString("en-us", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}
                    </time>
                    <span class="show">{getPodcastShow(ep.data.show)?.name}</span>
                    <a href={`${base}podcasts/${ep.slug}/`}>{ep.data.title}</a>
                </li>
            ))}
        </ul>
    </div>
</BaseLayout>

<style>
    .tag-page { max-width: 900px; }
    .breadcrumb { font-size: 0.85rem; color: var(--color-text-light); margin-bottom: 1rem; }
    .breadcrumb a { color: var(--color-primary); text-decoration: none; }
    h1 { font-size: 1.6rem; margin: 0 0 1rem; }
    ul { list-style: none; padding: 0; margin: 0; }
    li { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: baseline; padding: 0.4rem 0; border-bottom: 1px solid #f0f0f0; }
    time { font-family: monospace; font-size: 0.8rem; color: var(--color-text-light); min-width: 6.5rem; }
    .show { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: var(--color-secondary); }
    li a { color: var(--color-text); text-decoration: none; }
    li a:hover { color: var(--color-primary); }
</style>
