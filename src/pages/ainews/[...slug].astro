---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const entries = await getCollection("ainews");
    return entries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const isSynthesis = entry.data.type === "synthesis";
const isAnnualSynthesis = entry.data.type === "annual-synthesis";
const isEpisode = entry.data.type === "episode";
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    withSidebar={false}
>
    <article class="ainews-post">
        <nav class="breadcrumb">
            <a href={`${import.meta.env.BASE_URL}ainews/`}>AI Brief</a>
            <span class="breadcrumb-sep">›</span>
            <span>{isSynthesis ? "Monthly Synthesis" : isAnnualSynthesis ? "Annual Synthesis" : "Episode"}</span>
        </nav>

        <header class="ainews-post-header">
            {
                isSynthesis && (
                    <span class="type-badge synthesis-badge">
                        Monthly Synthesis
                    </span>
                )
            }
            {
                isAnnualSynthesis && (
                    <span class="type-badge annual-badge">
                        Annual Synthesis
                    </span>
                )
            }
            <h1>{entry.data.title}</h1>
            <div class="ainews-meta">
                <time datetime={entry.data.pubDate.toISOString()}>
                    {
                        entry.data.pubDate.toLocaleDateString("en-us", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>
            </div>
            {
                entry.data.tags.length > 0 && (
                    <div class="ainews-tags">
                        {entry.data.tags.map((tag) => (
                            <span class="tag-badge">{tag}</span>
                        ))}
                    </div>
                )
            }
            {
                isEpisode && entry.data.url && (
                    <a
                        href={entry.data.url}
                        class="listen-btn"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Listen to episode →
                    </a>
                )
            }
        </header>

        <div class="ainews-content">
            <Content />
        </div>

        <footer class="ainews-footer">
            <a href={`${import.meta.env.BASE_URL}ainews/`}>← Back to AI Brief</a>
        </footer>
    </article>
</BaseLayout>

<style>
    .ainews-post {
        max-width: 800px;
    }

    /* Breadcrumb */
    .breadcrumb {
        font-size: 0.85rem;
        color: var(--color-text-light);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .breadcrumb a {
        color: var(--color-primary);
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .breadcrumb-sep {
        color: var(--color-text-light);
    }

    /* Header */
    .ainews-post-header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .ainews-post-header h1 {
        font-size: 2rem;
        margin: 0.5rem 0 0.75rem;
        line-height: 1.2;
    }

    /* Type badge */
    .type-badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.2rem 0.6rem;
        border-radius: 3px;
        margin-bottom: 0.5rem;
    }

    .synthesis-badge {
        background: var(--color-primary);
        color: #fff;
    }

    .annual-badge {
        background: var(--color-secondary);
        color: #fff;
    }

    /* Meta */
    .ainews-meta {
        color: var(--color-text-light);
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    /* Tags */
    .ainews-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .tag-badge {
        background: var(--color-secondary);
        color: #fff;
        padding: 0.2rem 0.6rem;
        border-radius: 3px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    /* Listen button */
    .listen-btn {
        display: inline-block;
        background: var(--color-primary);
        color: #fff;
        padding: 0.5rem 1.25rem;
        border-radius: 4px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        margin-top: 0.5rem;
        transition: opacity 0.2s;
    }

    .listen-btn:hover {
        opacity: 0.85;
        color: #fff;
        text-decoration: none;
    }

    /* Content */
    .ainews-content {
        line-height: 1.7;
    }

    .ainews-content :global(h2) {
        font-size: 1.4rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }

    .ainews-content :global(h3) {
        font-size: 1.2rem;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }

    .ainews-content :global(pre) {
        background: #f5f5f5;
        padding: 1rem;
        overflow-x: auto;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .ainews-content :global(code) {
        background: #f0f0f0;
        padding: 0.15rem 0.3rem;
        border-radius: 3px;
        font-size: 0.9em;
    }

    .ainews-content :global(pre code) {
        background: none;
        padding: 0;
    }

    .ainews-content :global(ul),
    .ainews-content :global(ol) {
        margin: 1rem 0;
        padding-left: 1.5rem;
    }

    .ainews-content :global(li) {
        margin-bottom: 0.5rem;
    }

    /* Footer */
    .ainews-footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .ainews-footer a {
        color: var(--color-primary);
        text-decoration: none;
    }

    .ainews-footer a:hover {
        text-decoration: underline;
    }

    @media (max-width: 600px) {
        .ainews-post-header h1 {
            font-size: 1.3rem;
        }

        .ainews-content :global(h2),
        .ainews-content :global(h3) {
            margin-top: 1rem;
            margin-bottom: 0.25rem;
            font-size: 1.05rem;
        }

        .ainews-content :global(p) {
            margin-bottom: 0.5rem;
        }
    }
</style>
