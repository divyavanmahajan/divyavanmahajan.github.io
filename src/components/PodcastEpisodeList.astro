---
// Calendar grid + month-grouped episode list for one podcast show.
// Mirrors the look of src/pages/ainews/index.astro (kept separate so the AIDB
// page is untouched).
import type { CollectionEntry } from "astro:content";

interface Props {
    episodes: CollectionEntry<"podcasts">[];
}

const { episodes } = Astro.props;
const base = import.meta.env.BASE_URL;

const sorted = [...episodes].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const byMonth = new Map<string, CollectionEntry<"podcasts">[]>();
for (const ep of sorted) {
    const d = ep.data.pubDate;
    const key = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}`;
    if (!byMonth.has(key)) byMonth.set(key, []);
    byMonth.get(key)!.push(ep);
}
const monthKeys = [...byMonth.keys()].sort((a, b) => b.localeCompare(a));
const years = [...new Set(monthKeys.map((k) => Number(k.slice(0, 4))))].sort((a, b) => b - a);
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

function monthHeading(key: string) {
    const [y, m] = key.split("-").map(Number);
    return `${new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString("en-us", { month: "long", timeZone: "UTC" })} ${y}`;
}
---

{years.length > 0 && (
    <div class="calendar-wrapper">
        <div class="calendar-grid">
            <div></div>
            {MONTHS.map((m) => <div class="cal-month-header">{m}</div>)}
            {years.map((year) => (
                <>
                    <div class="cal-year-label">{year}</div>
                    {MONTHS.map((_, i) => {
                        const key = `${year}-${String(i + 1).padStart(2, "0")}`;
                        return byMonth.has(key) ? (
                            <div class="cal-cell"><a href={`#month-${key}`} class="cal-btn">{MONTHS[i]}</a></div>
                        ) : (
                            <div class="cal-cell"><span class="cal-dot">&middot;</span></div>
                        );
                    })}
                </>
            ))}
        </div>
    </div>
)}

<section class="episodes-section">
    {monthKeys.map((key) => (
        <div class="episode-month-group" id={`month-${key}`}>
            <h3 class="month-heading">{monthHeading(key)}</h3>
            <ul class="episode-list">
                {byMonth.get(key)!.map((ep) => (
                    <li class="episode-entry">
                        <time class="episode-date" datetime={ep.data.pubDate.toISOString()}>
                            {ep.data.pubDate.toLocaleDateString("en-us", { month: "short", day: "numeric", timeZone: "UTC" })}
                        </time>
                        <span class="episode-main">
                            <a href={`${base}podcasts/${ep.slug}/`} class="episode-title">{ep.data.title}</a>
                            {ep.data.guests.length > 0 && (
                                <span class="episode-guests">with {ep.data.guests.join(", ")}</span>
                            )}
                        </span>
                    </li>
                ))}
            </ul>
        </div>
    ))}
</section>

<style>
    .calendar-wrapper { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-bottom: 2rem; }
    .calendar-grid { display: grid; grid-template-columns: 3rem repeat(12, minmax(2.8rem, 1fr)); gap: 3px; min-width: 480px; }
    .cal-month-header { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-light); text-align: center; padding: 0.2rem 0; }
    .cal-year-label { font-size: 0.75rem; font-weight: 700; color: var(--color-text-light); display: flex; align-items: center; justify-content: flex-end; padding-right: 0.5rem; }
    .cal-cell { display: flex; align-items: center; justify-content: center; }
    .cal-btn { display: block; width: 100%; text-align: center; padding: 0.2rem 0.1rem; font-size: 0.65rem; font-weight: 600; background: #eeeae3; color: #8a7355; border: 1px solid #c4a97d; border-radius: 4px; text-decoration: none; line-height: 1.4; }
    .cal-btn:hover { background: #ddd7ce; color: #6b5a3e; text-decoration: none; }
    .cal-dot { font-size: 1rem; color: #ccc5b8; line-height: 1; }
    .episodes-section { margin-bottom: 2rem; }
    .episode-month-group { margin-bottom: 1.5rem; }
    .month-heading { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-secondary); margin: 0 0 0.5rem; padding-bottom: 0.3rem; border-bottom: 2px solid var(--color-secondary); display: inline-block; }
    .episode-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
    .episode-entry { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.3rem 0; border-bottom: 1px solid #f0f0f0; }
    .episode-entry:last-child { border-bottom: none; }
    .episode-date { font-family: monospace; font-size: 0.8rem; color: var(--color-text-light); flex-shrink: 0; min-width: 5rem; }
    .episode-main { display: flex; flex-direction: column; min-width: 0; }
    .episode-title { color: var(--color-text); text-decoration: none; font-size: 0.95rem; }
    .episode-title:hover { color: var(--color-primary); text-decoration: none; }
    .episode-guests { font-size: 0.8rem; color: var(--color-text-light); }
    @media (max-width: 600px) {
        .episode-entry { flex-direction: column; gap: 0.1rem; }
        .episode-date { font-size: 0.75rem; }
    }
</style>
